\f1\b\fs32 \cf0 2. ActiveJob Sample Code\
\pard\pardeftab720\partightenfactor0

\f0\b0 \cf0 Use ActiveJob coupled with an object storage system (like AWS S3) so your Rails server doesn't run out of storage space.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0

\fs40 \cf0 ruby\
\pard\pardeftab720\partightenfactor0

\f2\fs28 \cf0 # app/jobs/process_property_lidar_job.rb\
class ProcessPropertyLidarJob < ApplicationJob\
  queue_as :default\
\
  def perform(property_id)\
    property = Property.find(property_id)\
    \
    # 1. Define temporary workspace directories\
    workspace = Rails.root.join("tmp", "lidar_#\{property.id\}")\
    FileUtils.mkdir_p(workspace)\
    \
    raw_laz = workspace.join("raw.laz")\
    output_dir = workspace.join("potree_output")\
\
    # 2. Run PDAL to stream and clip directly from USGS S3\
    # (Uses the bounding box saved on the property model)\
    pdal_json = generate_pdal_pipeline_json(property.bbox, raw_laz)\
    File.write(workspace.join("pipeline.json"), pdal_json)\
    system("pdal pipeline #\{workspace.join('pipeline.json')\}")\
\
    # 3. Convert to Potree format\
    system("PotreeConverter #\{raw_laz\} -o #\{output_dir\}")\
\
    # 4. Upload directory to Cloud Storage (e.g., AWS S3 via AWS SDK)\
    # This keeps your Rails application thin and fast\
    s3_bucket = Aws::S3::Resource.new.bucket(ENV['AWS_BUCKET'])\
    Dir.glob("#\{output_dir\}/**/*").each do |file|\
      next if File.directory?(file)\
      rel_path = Pathname.new(file).relative_path_from(output_dir).to_s\
      s3_bucket.object("properties/#\{property.id\}/#\{rel_path\}").upload_file(file)\
    end\
\
    # 5. Clean up local tmp storage and update status\
    FileUtils.rm_rf(workspace)\
    property.update(status: :ready)\
  end\
\
  private\
\
  def generate_pdal_pipeline_json(bbox, output_path)\
    # Returns the PDAL JSON configuration string targeting the USGS endpoint\
  end\
end\
