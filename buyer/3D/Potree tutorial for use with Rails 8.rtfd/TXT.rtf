\f1\b\fs40 \cf0 5. Set Up the Potree Map View\
\pard\pardeftab720\partightenfactor0

\f0\b0\fs32 \cf0 In your Rails view, initialize the map view and load the dynamic path.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0

\fs40 \cf0 erb\
\pard\pardeftab720\partightenfactor0

\f2\fs28 \cf0 <!-- app/views/properties/show.html.erb -->\
<div class="potree_container" style="width: 100vw; height: 100vh; position: relative;">\
  <div id="potree_render_area" style="width: 100%; height: 100%; position: absolute;"></div>\
</div>\
\
<script>\
  document.addEventListener("DOMContentLoaded", () => \{\
    window.viewer = new Potree.Viewer(document.getElementById("potree_render_area"));\
    \
    viewer.setEDLEnabled(true); // Enhances edge contrast for building profiles\
    viewer.setPointBudget(2_000_000);\
    viewer.setBackground("gradient");\
\
    Potree.loadPointCloud("<%= @property.potree_path %>/metadata.json", "Property Cloud", (e) => \{\
      let scene = viewer.scene;\
      scene.addPointCloud(e.pointcloud);\
      \
      let material = e.pointcloud.material;\
      material.size = 1;\
      material.pointSizeType = Potree.PointSizeType.ADAPTIVE;\
      material.activeAttributeName = "color"; // Render with true RGB if available, or "elevation"\
      \
      viewer.fitToScreen();\
    \});\
  \});\
</script>\
