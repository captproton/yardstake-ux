{
  "gates": [
    {
      "name": "index matches a fresh scan",
      "tier": "fast",
      "cmd": [
        "{python}",
        "build_index.py",
        "--check"
      ]
    },
    {
      "name": "index gates",
      "tier": "fast",
      "cmd": [
        "{python}",
        "verify_index.py"
      ]
    },
    {
      "name": "page gates",
      "tier": "fast",
      "cmd": [
        "{python}",
        "verify_prototype.py"
      ]
    },
    {
      "name": "fixtures match their generator",
      "tier": "fast",
      "cmd": [
        "{python}",
        "prototype/fixtures/make_fixtures.py",
        "--check"
      ]
    },
    {
      "name": "kit tests (sheets, spec_lint, manifest, publish)",
      "tier": "fast",
      "requires": [
        "bin:pdfinfo",
        "bin:pdftotext",
        "yaml"
      ],
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "adu_kit.test_sheets",
        "adu_kit.test_spec_lint",
        "adu_kit.test_manifest",
        "adu_kit.test_publish"
      ]
    },
    {
      "name": "roof module tests (adu_kit/test_roof.py)",
      "tier": "fast",
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "adu_kit.test_roof"
      ]
    },
    {
      "name": "rectangle helpers tests (adu_kit/test_rectangle.py)",
      "tier": "fast",
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "adu_kit.test_rectangle"
      ]
    },
    {
      "name": "gate log and spec-read tests (adu_kit/test_gatelog.py)",
      "tier": "fast",
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "adu_kit.test_gatelog"
      ]
    },
    {
      "name": "new_model.py intake and scaffold tests",
      "tier": "fast",
      "requires": [
        "bin:pdfinfo",
        "bin:pdftotext",
        "yaml"
      ],
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "test_new_model"
      ]
    },
    {
      "name": "run_gates.py tests",
      "tier": "fast",
      "cmd": [
        "{python}",
        "-m",
        "unittest",
        "test_run_gates"
      ]
    },
    {
      "name": "probe harness self-check",
      "tier": "fast",
      "cmd": [
        "{python}",
        "probes/run_probes.py",
        "--self-check"
      ]
    },
    {
      "name": "probe suite",
      "tier": "probes",
      "requires": [
        "yaml",
        "blender"
      ],
      "cmd": [
        "{python}",
        "probes/run_probes.py"
      ]
    }
  ]
}
