\f2\fs28 \cf0 <!-- app/views/parcels/show.html.erb -->\
<div id="potree_render_area" style="width: 100%; height: 500px;"></div>\
\
<script>\
    window.viewer = new Potree.Viewer(document.getElementById("potree_render_area"));\
    viewer.setEDLEnabled(true); // Enhanced detail shadows\
    viewer.loadPointCloud("/twins/twin_<%= @homeowner.id %>/metadata.json", "Parcel Twin", e => \{\
        let scene = viewer.scene;\
        let pointcloud = e.pointcloud;\
        scene.addPointCloud(pointcloud);\
        viewer.fitToScreen();\
    \});\
</script>\
